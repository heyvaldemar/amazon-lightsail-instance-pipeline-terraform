# The images CI runs, pinned by digest: the same binaries verify this
# configuration here and on a contributor's machine.
#
# They live here rather than in the workflow because fleet triage moves
# them when a tag is rebuilt or a Terraform line is superseded, and the
# token it runs with has no `workflow` scope. An automation that could
# rewrite its own CI would have no ceiling; this file is the ceiling.
#
# Not named *.env on purpose: that pattern is ignored as a secrets file
# in some of these repositories, and a pin list is not a secret.
TERRAFORM_IMAGE=hashicorp/terraform:1.16@sha256:985cdc6c1d9b0a65b83377f666efd2f740b47f02ac55be1ced3d18f7d3b0e829
TFLINT_IMAGE=ghcr.io/terraform-linters/tflint:v0.59.1@sha256:2c23953d05388157922a76be1a5a767ff719cba029e026914f92604e665b0d31
